];

const vhuntTargets = ["made","took","flew","watched","worked","designed","weighed","started","climbed","hovered","landed","tore","announced","performed","extended","completed","scouted","became"];

const vhuntSentence = "On April 19 2021 a small helicopter made history NASA Ingenuity took off from the Martian surface and flew for 39 seconds Engineers watched the live data with nervous excitement The team worked on the project for six years They designed a lightweight helicopter that weighed only 1 8 kilograms The blades started spinning at 3 34 AM Ingenuity climbed to three metres hovered then landed safely After the flight MiMi Aung tore up her plan and announced the success NASA extended the mission The helicopter completed over 50 flights scouted terrain and became a historic achievement";

const rwData = [
  { present: "The engineers test the new thruster design in a vacuum chamber.", past: "The engineers tested the new thruster design in a vacuum chamber." },
  { present: "She writes the navigation algorithm and uploads it to the system.", past: "She wrote the navigation algorithm and uploaded it to the system." },
  { present: "The team discovers a critical flaw and stops the launch.", past: "The team discovered a critical flaw and stopped the launch." },
  { present: "He trains the model on a large dataset and checks the accuracy.", past: "He trained the model on a large dataset and checked the accuracy." },
];

const speakCards = [
  {
    tag: "Personal experience",
    prompt: "Tell me about a project or technical challenge you worked on. What did you do, and how did it go?",
    hint: "Use: worked on, designed, built, wrote, tested, fixed, completed…",
    followUps: ["How long did it take?", "What was the most difficult part?", "Did anything go wrong? What did you do?", "What did you learn from the experience?"]
  },
