<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Past Simple — Skills Practice | Alexander Filippov</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap" rel="stylesheet">
<style>
:root {
  --teal:     #028090;
  --teal-d:   #016676;
  --teal-l:   #E8F5F7;
  --teal-xl:  #F0FAFB;
  --navy:     #0D2B35;
  --navy-l:   #1A3D4A;
  --white:    #FFFFFF;
  --g50:      #F7FAFB;
  --g100:     #EFF4F5;
  --g200:     #D8E6E9;
  --g400:     #8AAAB0;
  --g600:     #4E6B72;
  --text:     #0D2B35;
  --tsub:     #4E6B72;
  --ok:       #1A7F5A;  --ok-bg:  #E6F6EF;
  --no:       #B02020;  --no-bg:  #FDEAEA;
  --ng:       #7A5500;  --ng-bg:  #FFF3D6;
  --r-sm: 6px; --r-md: 10px; --r-lg: 14px;
  --font: 'DM Sans', sans-serif;
  --mono: 'DM Mono', monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--g50);color:var(--text);min-height:100vh}

/* TOP BAR */
.topbar{position:sticky;top:0;z-index:100;background:var(--navy);height:52px;padding:0 24px;display:flex;align-items:center;gap:14px;box-shadow:0 2px 12px rgba(2,128,144,.2)}
.tb-logo{width:32px;height:32px;background:var(--teal);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0}
.tb-title{color:#fff;font-size:15px;font-weight:600}
.tb-sub{color:var(--g400);font-size:12px}
.tb-pills{margin-left:auto;display:flex;gap:6px}
.tb-pill{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;letter-spacing:.04em;border:1px solid transparent}
.pill-r{background:#1a4a55;color:#7EC8D3;border-color:#1d5566}
.pill-w{background:#1a3d1a;color:#6FCF6F;border-color:#1f4d1f}
.pill-s{background:#3d2a00;color:#F5C36A;border-color:#4d3500}

/* PROGRESS */
.prog-bar{height:3px;background:var(--g200)}
.prog-fill{height:100%;background:var(--teal);transition:width .4s}

/* LAYOUT */
.page{max-width:820px;margin:0 auto;padding:32px 20px 80px}

/* SKILL DIVIDER */
.skill-banner{display:flex;align-items:center;gap:16px;padding:14px 20px;border-radius:var(--r-lg);margin:36px 0 20px;border:1px solid var(--g200)}
.skill-banner:first-child{margin-top:0}
.sk-reading{background:linear-gradient(135deg,#e8f5f7,#d0ecf0)}
.sk-writing{background:linear-gradient(135deg,#edf7ed,#d4efd4)}
.sk-speaking{background:linear-gradient(135deg,#fff8e8,#fcedc8)}
.skill-icon{font-size:28px;flex-shrink:0}
.skill-name{font-size:19px;font-weight:700;color:var(--navy)}
.skill-desc{font-size:13px;color:var(--tsub);margin-top:2px}
.skill-time{margin-left:auto;font-size:12px;color:var(--tsub);white-space:nowrap;font-weight:500}

/* SECTION HEADER */
.sec-hdr{display:flex;align-items:flex-start;gap:12px;margin-bottom:14px;margin-top:22px}
.sec-num{width:34px;height:34px;background:var(--teal);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:700;flex-shrink:0;box-shadow:0 2px 8px rgba(2,128,144,.2)}
.sec-title{font-size:16px;font-weight:700;color:var(--navy)}
.sec-desc{font-size:12.5px;color:var(--tsub);margin-top:2px;line-height:1.5}

/* CARDS */
.card{background:var(--white);border:1px solid var(--g200);border-radius:var(--r-lg);margin-bottom:10px;overflow:hidden}
.card:hover{box-shadow:0 2px 12px rgba(2,128,144,.07)}
.card-inner{padding:16px 18px}

/* THEORY */
.theory{background:var(--teal-xl);border:1px solid var(--g200);border-left:3px solid var(--teal);border-radius:0 var(--r-md) var(--r-md) 0;padding:11px 15px;margin-bottom:14px;font-size:13px;line-height:1.7;color:var(--text)}
.theory strong{color:var(--teal-d)}

/* READING TEXT */
.reading-text{font-size:14.5px;line-height:1.85;color:var(--text);padding:18px 20px;background:var(--white);border:1px solid var(--g200);border-radius:var(--r-lg);margin-bottom:12px}
.reading-text h3{font-size:16px;font-weight:700;color:var(--navy);margin-bottom:12px}
.reading-text p{margin-bottom:10px}
.reading-text p:last-child{margin-bottom:0}
.ps-verb{border-bottom:2px solid var(--teal);color:var(--teal-d);cursor:help}

/* VOCAB TABLE */
.vocab-table{width:100%;border-collapse:collapse;font-size:13px}
.vocab-table th{background:var(--teal);color:#fff;padding:5px 10px;text-align:left;font-weight:600;font-size:12px}
.vocab-table td{padding:6px 10px;border-bottom:1px solid var(--g200);vertical-align:top}
.vocab-table tr:last-child td{border-bottom:none}
.vocab-table tr:nth-child(even) td{background:var(--teal-xl)}

/* TF BUTTONS */
.tf-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.tf-row:last-child{margin-bottom:0}
.tf-stmt{font-size:13.5px;flex:1;line-height:1.5}
.tf-btns{display:flex;gap:5px;flex-shrink:0}
.tf-btn{font-size:11px;font-weight:700;padding:4px 10px;border-radius:var(--r-sm);border:1.5px solid var(--g200);background:var(--white);cursor:pointer;letter-spacing:.04em;transition:all .15s}
.tf-btn:hover{border-color:var(--teal);background:var(--teal-xl)}
.tf-btn.sel-T{background:#d4efd4;border-color:#1A7F5A;color:var(--ok)}
.tf-btn.sel-F{background:var(--no-bg);border-color:var(--no);color:var(--no)}
.tf-btn.sel-NG{background:var(--ng-bg);border-color:#c49000;color:var(--ng)}
.tf-btn.correct{background:var(--ok-bg);border-color:var(--ok);color:var(--ok)}
.tf-btn.wrong{background:var(--no-bg);border-color:var(--no);color:var(--no)}

/* COMPREHENSION TEXT AREAS */
.comp-q{margin-bottom:14px}
.comp-q:last-child{margin-bottom:0}
.comp-label{font-size:13.5px;margin-bottom:6px;line-height:1.5}
.comp-q .q-num{display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;background:var(--g100);border-radius:50%;font-size:11px;font-weight:700;color:var(--tsub);margin-right:6px}
textarea.ans-ta{width:100%;min-height:64px;font-family:var(--font);font-size:13px;border:1.5px solid var(--g200);border-radius:var(--r-sm);padding:8px 11px;resize:vertical;outline:none;transition:border-color .15s;color:var(--text)}
textarea.ans-ta:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(2,128,144,.1)}

/* VERB HUNT */
.vhunt-grid{display:flex;flex-wrap:wrap;gap:6px;font-size:13.5px;line-height:1.8}
.vhunt-word{cursor:pointer;padding:2px 7px;border-radius:4px;border:1.5px solid transparent;transition:all .15s;user-select:none}
.vhunt-word:hover{background:var(--teal-xl);border-color:var(--teal)}
.vhunt-word.marked{background:var(--teal);color:#fff;border-color:var(--teal-d)}
.vhunt-count{font-size:12px;color:var(--tsub);margin-top:8px}
.vhunt-count span{font-weight:700;color:var(--teal-d)}

/* WRITING */
.wc-bar{display:flex;gap:10px;align-items:center;margin-top:6px}
.wc-label{font-size:12px;color:var(--tsub)}
.wc-num{font-weight:700;color:var(--teal-d)}
.wc-target{color:var(--tsub)}
textarea.write-area{width:100%;min-height:140px;font-family:var(--font);font-size:13.5px;border:1.5px solid var(--g200);border-radius:var(--r-md);padding:12px 14px;resize:vertical;outline:none;transition:border-color .15s;line-height:1.7}
textarea.write-area:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(2,128,144,.1)}
.writing-prompts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.wp-item{background:var(--teal-xl);border:1px solid var(--g200);border-radius:var(--r-md);padding:10px 12px;font-size:12.5px;color:var(--text);line-height:1.5}
.wp-item strong{display:block;font-size:11px;color:var(--teal-d);letter-spacing:.05em;margin-bottom:3px;text-transform:uppercase}
.checklist{margin-top:12px}
.check-item{display:flex;align-items:flex-start;gap:9px;margin-bottom:7px;font-size:13px;cursor:pointer;user-select:none}
.check-item:last-child{margin-bottom:0}
.check-box{width:18px;height:18px;border:2px solid var(--g400);border-radius:4px;flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.check-item.checked .check-box{background:var(--teal);border-color:var(--teal-d)}
.check-item.checked .check-box::after{content:'✓';font-size:11px;color:#fff;font-weight:700}
.check-item.checked .check-text{color:var(--tsub);text-decoration:line-through}
.reveal-btn{font-family:var(--font);font-size:12.5px;font-weight:600;color:var(--teal-d);background:var(--teal-xl);border:1.5px solid var(--g200);border-radius:var(--r-sm);padding:6px 14px;cursor:pointer;transition:all .15s}
.reveal-btn:hover{background:var(--teal-l);border-color:var(--teal)}
.model-answer{display:none;margin-top:10px;padding:13px 15px;background:var(--g50);border:1px solid var(--g200);border-radius:var(--r-md);font-size:13px;line-height:1.75}
.model-answer.show{display:block}
.model-answer strong{color:var(--teal-d);font-size:11px;letter-spacing:.05em;text-transform:uppercase;display:block;margin-bottom:5px}

/* SPEAKING */
.speak-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.speak-card{background:var(--white);border:1px solid var(--g200);border-radius:var(--r-lg);overflow:hidden;cursor:pointer;transition:all .2s;perspective:600px}
.speak-card:hover{box-shadow:0 4px 14px rgba(2,128,144,.12);transform:translateY(-2px)}
.speak-card-inner{position:relative;width:100%;transition:transform .5s;transform-style:preserve-3d}
.speak-card.flipped .speak-card-inner{transform:rotateY(180deg)}
.speak-front,.speak-back{border-radius:var(--r-lg);overflow:hidden}
.speak-back{position:absolute;top:0;left:0;width:100%;backface-visibility:hidden;transform:rotateY(180deg);background:var(--navy)}
.speak-front{backface-visibility:hidden}
.speak-front-top{background:var(--teal);padding:10px 14px;display:flex;align-items:center;gap:8px}
.speak-card-num{font-size:11px;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:.05em}
.speak-front-tag{font-size:11px;font-weight:600;color:#fff;background:rgba(255,255,255,.15);padding:2px 8px;border-radius:12px;margin-left:auto}
.speak-front-body{padding:14px}
.speak-prompt{font-size:13.5px;font-weight:600;color:var(--navy);line-height:1.5;margin-bottom:8px}
.speak-hint{font-size:12px;color:var(--tsub);line-height:1.5}
.speak-flip-hint{font-size:11px;color:var(--g400);text-align:right;margin-top:8px}
.speak-back-body{padding:14px}
.speak-back-label{font-size:10px;color:rgba(255,255,255,.5);letter-spacing:.07em;text-transform:uppercase;margin-bottom:8px}
.speak-back-qs{list-style:none}
.speak-back-qs li{font-size:12.5px;color:rgba(255,255,255,.85);padding:4px 0;border-bottom:1px solid rgba(255,255,255,.08);line-height:1.5}
.speak-back-qs li:last-child{border-bottom:none}
.speak-back-qs li::before{content:'→ ';color:var(--teal);font-weight:700}

/* ROLEPLAY */
.roleplay-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.role-card{border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--g200)}
.role-card-head{padding:10px 14px;font-size:12px;font-weight:700;letter-spacing:.05em}
.role-A .role-card-head{background:var(--teal);color:#fff}
.role-B .role-card-head{background:var(--navy);color:#fff}
.role-card-body{padding:13px 15px;font-size:13px;line-height:1.6}
.role-card-body ul{padding-left:0;list-style:none}
.role-card-body ul li{padding:3px 0;border-bottom:1px solid var(--g200)}
.role-card-body ul li:last-child{border-bottom:none}
.role-card-body ul li::before{content:'• ';color:var(--teal);font-weight:700}
.role-situation{background:var(--teal-xl);border:1px solid var(--g200);border-radius:var(--r-md);padding:11px 14px;font-size:13px;line-height:1.6;margin-bottom:10px}

/* TIMER */
.timer-wrap{display:flex;align-items:center;gap:10px;margin-top:10px}
.timer-display{font-family:var(--mono);font-size:22px;font-weight:500;color:var(--navy);background:var(--g100);border-radius:var(--r-sm);padding:4px 14px;min-width:80px;text-align:center}
.timer-display.running{color:var(--teal-d);background:var(--teal-xl)}
.timer-display.done{color:var(--ok);background:var(--ok-bg)}
.btn{display:inline-flex;align-items:center;gap:7px;font-family:var(--font);font-size:13px;font-weight:600;padding:8px 18px;border-radius:var(--r-md);border:none;cursor:pointer;transition:all .15s}
.btn-primary{background:var(--teal);color:#fff}
.btn-primary:hover{background:var(--teal-d);box-shadow:0 3px 10px rgba(2,128,144,.3)}
.btn-ghost{background:transparent;color:var(--tsub);border:1.5px solid var(--g200)}
.btn-ghost:hover{border-color:var(--teal);color:var(--teal-d);background:var(--teal-xl)}
.btn-row{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap;align-items:center}

/* RESULT */
.result-box{margin-top:12px;padding:12px 15px;border-radius:var(--r-md);font-size:13px;line-height:1.6;display:none}
.result-box.show{display:block}
.result-box.correct{background:var(--ok-bg);border:1px solid #A8D9C0;color:var(--ok)}
.result-box.partial{background:#fff8e8;border:1px solid #f0d58a;color:var(--ng)}
.result-box.wrong{background:var(--no-bg);border:1px solid #edb8b8;color:var(--no)}
</style>
</head>
<body>

<div class="topbar">
  <div class="tb-logo">PS</div>
  <div>
    <div class="tb-title">Past Simple — Skills Practice</div>
    <div class="tb-sub">Alexander Filippov · B1</div>
  </div>
  <div class="tb-pills">
    <span class="tb-pill pill-r">📖 Reading</span>
    <span class="tb-pill pill-w">✏️ Writing</span>
    <span class="tb-pill pill-s">🎙 Speaking</span>
  </div>
</div>
<div class="prog-bar"><div class="prog-fill" id="prog" style="width:0%"></div></div>

<div class="page">

<!-- ═══════════════════════════════
     READING
════════════════════════════════ -->
<div class="skill-banner sk-reading">
  <div class="skill-icon">📖</div>
  <div>
    <div class="skill-name">Reading</div>
    <div class="skill-desc">Text · Vocabulary · T/F/NG · Comprehension · Verb Hunt</div>
  </div>
  <div class="skill-time">⏱ ~20 min</div>
</div>

<!-- VOCAB PRE-TASK -->
<div class="sec-hdr">
  <div class="sec-num">A</div>
  <div>
    <div class="sec-title">Pre-reading: Key Vocabulary</div>
    <div class="sec-desc">Study these words before you read. They appear in the text.</div>
  </div>
</div>

<div class="card">
  <div class="card-inner">
    <table class="vocab-table">
      <thead><tr><th>Word / phrase</th><th>Part of speech</th><th>Meaning</th></tr></thead>
      <tbody>
        <tr><td><strong>lightweight</strong></td><td>adjective</td><td>not heavy; low in mass relative to its size</td></tr>
        <tr><td><strong>hover</strong></td><td>verb</td><td>to remain stationary in the air</td></tr>
        <tr><td><strong>contingency plan</strong></td><td>noun phrase</td><td>a backup plan prepared in case something goes wrong</td></tr>
        <tr><td><strong>proof of concept</strong></td><td>noun phrase</td><td>a demonstration that an idea actually works in practice</td></tr>
        <tr><td><strong>scout</strong></td><td>verb</td><td>to explore an area in advance to gather useful information</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- READING TEXT -->
<div class="sec-hdr" style="margin-top:22px;">
  <div class="sec-num">B</div>
  <div>
    <div class="sec-title">Read the text</div>
    <div class="sec-desc">Underlined words are Past Simple verbs. Click any word to highlight it.</div>
  </div>
</div>

<div class="reading-text" id="reading-text">
  <h3>The Day Ingenuity Flew on Mars</h3>
  <p>On April 19, 2021, a small helicopter <span class="ps-verb" title="Past Simple: make → made">made</span> history. NASA's Ingenuity helicopter <span class="ps-verb" title="Past Simple: take off → took off">took off</span> from the Martian surface and <span class="ps-verb" title="Past Simple: fly → flew">flew</span> for 39.1 seconds. Engineers at the Jet Propulsion Laboratory in Pasadena, California <span class="ps-verb" title="Past Simple: watch → watched">watched</span> the live data with nervous excitement.</p>

  <p>The team <span class="ps-verb" title="Past Simple: work → worked">worked</span> on the Ingenuity project for six years. They <span class="ps-verb" title="Past Simple: design → designed">designed</span> a lightweight helicopter that could operate in Mars' thin atmosphere — about 100 times thinner than Earth's. The aircraft <span class="ps-verb" title="Past Simple: weigh → weighed">weighed</span> only 1.8 kilograms and used two carbon-fibre rotor blades that <span class="ps-verb" title="Past Simple: spin → spun">spun</span> at 2,500 revolutions per minute.</p>

  <p>On the morning of the flight, the blades <span class="ps-verb" title="Past Simple: start → started">started</span> spinning at 3:34 AM local time. Ingenuity <span class="ps-verb" title="Past Simple: climb → climbed">climbed</span> to a height of three metres, <span class="ps-verb" title="Past Simple: hover → hovered">hovered</span> steadily for about 30 seconds, then <span class="ps-verb" title="Past Simple: land → landed">landed</span> safely on the red dust. The flight lasted less than a minute, but the achievement was enormous.</p>

  <p>After the flight, chief engineer MiMi Aung <span class="ps-verb" title="Past Simple: tear → tore">tore</span> up the contingency plan she had prepared in case Ingenuity failed. "We didn't need it," she <span class="ps-verb" title="Past Simple: announce → announced">announced</span> to her team.</p>

  <p>Ingenuity originally <span class="ps-verb" title="Past Simple: fly → flew">flew</span> as a technology demonstration — a proof of concept. But it <span class="ps-verb" title="Past Simple: perform → performed">performed</span> so well that NASA <span class="ps-verb" title="Past Simple: extend → extended">extended</span> its mission. The helicopter <span class="ps-verb" title="Past Simple: complete → completed">completed</span> over 50 flights and <span class="ps-verb" title="Past Simple: scout → scouted">scouted</span> terrain for the Perseverance rover. What many people doubted <span class="ps-verb" title="Past Simple: become → became">became</span> one of the most inspiring engineering achievements of the decade.</p>
</div>

<!-- T/F/NG -->
<div class="sec-hdr">
  <div class="sec-num">C</div>
  <div>
    <div class="sec-title">True / False / Not Given</div>
    <div class="sec-desc">Based on the text only. <strong>Not Given</strong> = the text does not say either way.</div>
  </div>
</div>

<div class="card">
  <div class="card-inner">
    <div id="tfng-questions"></div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="checkTFNG()">Check answers</button>
      <button class="btn btn-ghost" onclick="resetTFNG()">Reset</button>
    </div>
    <div class="result-box" id="tfng-result"></div>
  </div>
</div>

<!-- COMPREHENSION QUESTIONS -->
<div class="sec-hdr">
  <div class="sec-num">D</div>
  <div>
    <div class="sec-title">Comprehension Questions</div>
    <div class="sec-desc">Answer in your own words. Use Past Simple where appropriate.</div>
  </div>
</div>

<div class="card">
  <div class="card-inner" id="comp-questions"></div>
</div>

<!-- VERB HUNT -->
<div class="sec-hdr">
  <div class="sec-num">E</div>
  <div>
    <div class="sec-title">Verb Hunt</div>
    <div class="sec-desc">Find and click <strong>10 Past Simple verbs</strong> in the text below. Regular and irregular both count.</div>
  </div>
</div>

<div class="card">
  <div class="card-inner">
    <div class="vhunt-grid" id="vhunt-text"></div>
    <div class="vhunt-count">Found: <span id="vhunt-num">0</span> / 10 target verbs</div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="checkVHunt()">Check</button>
      <button class="btn btn-ghost" onclick="resetVHunt()">Reset</button>
    </div>
    <div class="result-box" id="vhunt-result"></div>
  </div>
</div>


<!-- ═══════════════════════════════
     WRITING
════════════════════════════════ -->
<div class="skill-banner sk-writing" style="margin-top:40px;">
  <div class="skill-icon">✏️</div>
  <div>
    <div class="skill-name">Writing</div>
    <div class="skill-desc">Guided paragraph · Story continuation · Self-editing checklist</div>
  </div>
  <div class="skill-time">⏱ ~20 min</div>
</div>

<!-- WRITING TASK 1 -->
<div class="sec-hdr">
  <div class="sec-num">F</div>
  <div>
    <div class="sec-title">Guided Writing — A Past Achievement</div>
    <div class="sec-desc">Write 100–150 words about a project, experiment, or goal you completed in the past. Use Past Simple throughout.</div>
  </div>
</div>

<div class="card">
