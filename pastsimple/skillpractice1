// ════════════════════════════════════════
// BUILD TFNG
// ════════════════════════════════════════
function buildTFNG() {
  const container = document.getElementById('tfng-questions');
  container.innerHTML = '';
  tfngData.forEach((item, i) => {
    const row = document.createElement('div');
    row.className = 'tf-row';
    row.id = 'tfng-' + i;
    row.innerHTML = `
      <div class="tf-stmt"><span style="font-size:11px;font-weight:700;color:var(--tsub);margin-right:4px;">${i+1}.</span> ${item.stmt}</div>
      <div class="tf-btns">
        <button class="tf-btn" data-val="T" onclick="selectTF(${i},'T')">T</button>
        <button class="tf-btn" data-val="F" onclick="selectTF(${i},'F')">F</button>
        <button class="tf-btn" data-val="NG" onclick="selectTF(${i},'NG')">NG</button>
      </div>`;
    container.appendChild(row);
  });
}

function selectTF(i, val) {
  const row = document.getElementById('tfng-' + i);
  row.querySelectorAll('.tf-btn').forEach(b => {
    b.className = 'tf-btn';
    if (b.dataset.val === val) b.classList.add('sel-' + val);
  });
}

function checkTFNG() {
  let correct = 0;
  tfngData.forEach((item, i) => {
    const row = document.getElementById('tfng-' + i);
    const btns = row.querySelectorAll('.tf-btn');
    let chosen = null;
    btns.forEach(b => { if (b.classList.contains('sel-' + b.dataset.val)) chosen = b.dataset.val; });
    btns.forEach(b => {
      b.className = 'tf-btn';
      b.onclick = null;
      if (b.dataset.val === item.answer) b.classList.add('correct');
      else if (b.dataset.val === chosen) b.classList.add('wrong');
    });
    if (chosen === item.answer) correct++;
    // show explanation
    if (!row.querySelector('.tf-explain')) {
      const exp = document.createElement('div');
      exp.className = 'tf-explain';
      exp.style.cssText = 'font-size:11.5px;color:var(--tsub);margin-top:4px;font-style:italic;flex-basis:100%;padding-left:4px;';
      exp.textContent = '→ ' + item.explain;
      row.appendChild(exp);
    }
  });
  const rb = document.getElementById('tfng-result');
  rb.className = 'result-box show ' + (correct === tfngData.length ? 'correct' : correct >= 4 ? 'partial' : 'wrong');
  rb.innerHTML = `<strong>${correct} / ${tfngData.length}</strong> correct.`;
  updateProg();
}

function resetTFNG() {
  buildTFNG();
  document.getElementById('tfng-result').className = 'result-box';
}

// ════════════════════════════════════════
// BUILD COMPREHENSION
// ════════════════════════════════════════
function buildComp() {
  const container = document.getElementById('comp-questions');
  container.innerHTML = '';
  compQs.forEach((q, i) => {
    const div = document.createElement('div');
    div.className = 'comp-q';
    div.innerHTML = `
      <div class="comp-label"><span class="q-num">${i+1}</span> ${q}</div>
      <textarea class="ans-ta" placeholder="Your answer…"></textarea>`;
    container.appendChild(div);
  });
}

// ════════════════════════════════════════
// VERB HUNT
// ════════════════════════════════════════
const markedVerbs = new Set();
const TARGET_COUNT = 10;

function buildVHunt() {
  const container = document.getElementById('vhunt-text');
  container.innerHTML = '';
  markedVerbs.clear();
  const words = vhuntSentence.split(' ');
  words.forEach((word, i) => {
    const clean = word.toLowerCase().replace(/[^a-z]/g, '');
    const span = document.createElement('span');
    span.className = 'vhunt-word';
    span.textContent = word + ' ';
    span.dataset.word = clean;
    span.dataset.idx = i;
    span.onclick = function() {
      if (span.classList.contains('marked')) {
        span.classList.remove('marked');
        markedVerbs.delete(i + '_' + clean);
      } else {
        span.classList.add('marked');
        markedVerbs.add(i + '_' + clean);
      }
      document.getElementById('vhunt-num').textContent = markedVerbs.size;
    };
    container.appendChild(span);
  });
}

function checkVHunt() {
  let correct = 0, total = 0;
  document.querySelectorAll('#vhunt-text .vhunt-word').forEach(span => {
    const w = span.dataset.word;
    const isTarget = vhuntTargets.includes(w);
    const isMarked = span.classList.contains('marked');
    if (isTarget) {
      span.style.background = var_or('#E6F6EF');
      span.style.borderColor = '#1A7F5A';
      span.style.color = '#1A7F5A';
      total++;
      if (isMarked) correct++;
    } else if (isMarked) {
      span.style.background = '#FDEAEA';
      span.style.borderColor = '#B02020';
      span.style.color = '#B02020';
    }
    span.onclick = null;
  });
  const rb = document.getElementById('vhunt-result');
  rb.className = 'result-box show ' + (correct >= TARGET_COUNT ? 'correct' : 'partial');
  rb.innerHTML = `You found <strong>${correct}</strong> of ${total} Past Simple verbs. All verbs are now highlighted in green.`;
  updateProg();
}

function var_or(v) { return v; }

function resetVHunt() {
  buildVHunt();
  document.getElementById('vhunt-result').className = 'result-box';
  document.getElementById('vhunt-num').textContent = '0';
}

// ════════════════════════════════════════
// REWRITE EXERCISE
// ════════════════════════════════════════
function buildRW() {
  const container = document.getElementById('rw-questions');
  container.innerHTML = '<div class="task-label" style="margin-bottom:14px;">Rewrite in Past Simple</div>';
  rwData.forEach((item, i) => {
    const div = document.createElement('div');
    div.className = 'comp-q';
    div.style.marginBottom = '16px';
    div.innerHTML = `
      <div class="comp-label">
        <span class="q-num">${i+1}</span>
        <strong>Present:</strong> <em>${item.present}</em>
      </div>
      <div style="margin-top:6px;margin-left:28px;font-size:13px;color:var(--tsub);margin-bottom:6px;">→ Past Simple:</div>
      <div style="margin-left:28px;">
        <input type="text" class="ans-input"
          style="width:100%;max-width:560px;font-family:var(--font);font-size:13px;border:1.5px solid var(--g200);border-radius:var(--r-sm);padding:7px 11px;outline:none;transition:border-color .15s;"
          autocomplete="off" autocorrect="off" spellcheck="false"
          data-answer="${item.past}"
          placeholder="Rewrite here…"
          onfocus="this.style.borderColor='var(--teal)'" onblur="this.style.borderColor='var(--g200)'">
      </div>`;
    container.appendChild(div);
  });
  const btnRow = document.createElement('div');
  btnRow.className = 'btn-row';
  btnRow.innerHTML = `<button class="btn btn-primary" onclick="checkRW()">Check</button><button class="btn btn-ghost" onclick="buildRW()">Reset</button>
  <div class="result-box" id="rw-result" style="margin-top:0;flex:1;"></div>`;
  container.appendChild(btnRow);
}

function checkRW() {
  const inputs = document.querySelectorAll('#rw-questions .ans-input');
  let correct = 0;
  inputs.forEach(inp => {
    inp.readOnly = true;
    const got = inp.value.trim().toLowerCase().replace(/[.!?]+$/,'');
    const exp = inp.dataset.answer.trim().toLowerCase().replace(/[.!?]+$/,'');
    const ok = got === exp;
    inp.style.borderColor = ok ? 'var(--ok)' : 'var(--no)';
    inp.style.background = ok ? 'var(--ok-bg)' : 'var(--no-bg)';
    if (ok) correct++;
    else {
      const hint = document.createElement('div');
      hint.style.cssText = 'font-size:11.5px;color:var(--ok);margin-top:3px;margin-left:28px;';
      hint.textContent = '✓ ' + inp.dataset.answer;
      inp.parentElement.appendChild(hint);
    }
  });
  const rb = document.getElementById('rw-result');
  rb.className = 'result-box show ' + (correct === rwData.length ? 'correct' : 'partial');
  rb.innerHTML = `<strong>${correct} / ${rwData.length}</strong> correct.`;
  updateProg();
}

// ════════════════════════════════════════
// WRITING HELPERS
// ════════════════════════════════════════
function updateWC(taId, wcId, min, max) {
  const text = document.getElementById(taId).value.trim();
  const count = text === '' ? 0 : text.split(/\s+/).length;
  const el = document.getElementById(wcId);
  el.textContent = count;
  el.style.color = count >= min && count <= max ? 'var(--ok)' : count > max ? 'var(--no)' : 'var(--teal-d)';
}

function toggleCheck(el) {
  el.classList.toggle('checked');
}

function toggleModel(id) {
  const el = document.getElementById(id);
  const btn = el.previousElementSibling.querySelector('.reveal-btn');
  el.classList.toggle('show');
  if (btn) btn.textContent = el.classList.contains('show') ? '🙈 Hide model answer' : '👁 Show model answer';
}

