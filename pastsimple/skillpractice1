<script>
// ════════════════════════════════════════
// DATA
// ════════════════════════════════════════

const tfngData = [
  { stmt: "The Ingenuity helicopter flew for exactly one minute.", answer: "F", explain: "It flew for 39.1 seconds — less than a minute." },
  { stmt: "Engineers at the Jet Propulsion Laboratory watched the flight data in real time.", answer: "T", explain: "The text says they 'watched the live data'." },
  { stmt: "Ingenuity used four rotor blades to generate lift.", answer: "F", explain: "The text says 'two carbon-fibre rotor blades'." },
  { stmt: "MiMi Aung prepared a backup plan before the flight in case it failed.", answer: "T", explain: "The text says she 'prepared a contingency plan in case Ingenuity failed'." },
  { stmt: "NASA planned from the beginning to fly Ingenuity more than 50 times.", answer: "NG", explain: "The text says it 'originally flew as a technology demonstration', and the extended mission came later — the original plan isn't described." },
